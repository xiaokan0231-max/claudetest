# YouTube Data API v3 key. Restrict this key to the YouTube Data API in Google Cloud.
YOUTUBE_API_KEY=

# Local MySQL administrator connection used only by `db:init`.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=

# Application connection.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=sns_trend_lab
MYSQL_USER=sns_collector
MYSQL_PASSWORD=replace-with-a-local-password

# Collection and reporting defaults.
SNS_TIMEZONE=Asia/Tokyo
# Guardrail for the standard YouTube quota pool, in real units. YouTube bills
# search.list at 100 units and most list calls at 1; the free tier is 10,000/day.
SNS_QUOTA_BUDGET=10000
# Guardrail for the number of search.list REQUESTS per day (each also costs 100
# standard units, counted against SNS_QUOTA_BUDGET above).
SNS_SEARCH_QUOTA_BUDGET=100
SNS_ACTIVE_WINDOW_DAYS=30

# Optional outbound proxy for YouTube API requests. Node's fetch ignores the
# standard HTTPS_PROXY/HTTP_PROXY variables, so set this when the machine reaches
# the internet through a local proxy (e.g. Clash/V2Ray) that blocks direct egress.
# Setting it here (rather than only exporting HTTPS_PROXY in your shell) is what
# makes scheduled launchd collection work — launchd does not inherit shell env.
# SNS_HTTPS_PROXY=http://127.0.0.1:7892

# Read-only Google Cloud Monitoring quota lookup. Authenticate locally with:
# gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=

# Comment collection (public YouTube comments -> pseudonymized opinion data).
# Author IDs are HMAC-hashed with COMMENT_HMAC_SALT (same account -> same key),
# and comment text is PII-scrubbed before storage. Never commit the salt.
SNS_COLLECT_COMMENTS=true
COMMENT_HMAC_SALT=replace-with-a-long-random-secret
SNS_COMMENT_MAX_VIDEOS=20
SNS_COMMENT_MAX_PER_VIDEO=200
SNS_COMMENT_MAX_PAGES=2
SNS_COMMENT_ORDER=relevance
